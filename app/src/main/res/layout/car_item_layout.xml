<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="20dp"
    android:layout_marginVertical="10dp"
    android:background="@drawable/edit_text_border"
    android:orientation="vertical"
    android:paddingVertical="20dp"
    android:paddingStart="20dp"
    tools:ignore="RtlSymmetry">

    <FrameLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">

        <TextView
            android:id="@+id/car_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:fontFamily="@font/montserrat_semibold"
            android:textColor="@color/secondary_black"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/car_brand"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="40dp"
            android:fontFamily="@font/montserrat_semibold"
            android:textColor="@color/primary_grey"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/car_price"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="70dp"
            android:fontFamily="@font/montserrat_semibold"
            android:textColor="@color/secondary_black"
            android:textSize="12sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="50dp"
            android:layout_marginTop="70dp"
            android:fontFamily="@font/montserrat_semibold"
            android:text="₽ в день"
            android:textColor="@color/primary_grey"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/car_gearbox"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="100dp"
            android:fontFamily="@font/montserrat_medium"
            android:text="A/T"
            app:drawableStartCompat="@drawable/gearbox" />

        <TextView
            android:id="@+id/car_energy"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="60dp"
            android:layout_marginTop="100dp"
            android:fontFamily="@font/montserrat_medium"
            android:text="Бензин"
            app:drawableStartCompat="@drawable/fuel" />

        <ImageView
            android:id="@+id/car_image"
            android:layout_width="175dp"
            android:layout_height="130dp"
            android:layout_marginStart="130dp"
            android:contentDescription="car_image" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/rent_button"
            android:layout_width="140dp"
            android:layout_height="50dp"
            android:fontFamily="@font/montserrat_medium"
            android:paddingHorizontal="0dp"
            android:text="@string/rent"
            android:textSize="16sp"
            app:cornerRadius="10dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/details_button"
            android:layout_width="130dp"
            android:layout_height="40dp"
            android:layout_marginStart="20dp"
            android:background="@drawable/edit_text_border"
            android:fontFamily="@font/montserrat_medium"
            android:paddingHorizontal="0dp"
            android:text="@string/details"
            android:textColor="@color/secondary_black"
            android:textSize="16sp"
            app:cornerRadius="10dp" />

    </LinearLayout>

</LinearLayout>